# Copy to .env - used by docker-compose.yml
WEB_PORT=8080

# IMPORTANT: use a long random value outside of local testing
JWT_SECRET=change-this-secret-before-deploying
JWT_EXPIRES_IN=7d

# First admin account (created automatically when the API starts)
ADMIN_NAME=UniFind Admin
ADMIN_EMAIL=admin@unifind.lk
ADMIN_PASSWORD=Admin@12345
